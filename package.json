{
  "name": "@masatomakino/threejs-spherical-controls",
  "version": "0.10.1",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "exports": {
    ".": {
      "import": {
        "types": "./esm/index.d.ts",
        "default": "./esm/index.js"
      },
      "default": {
        "types": "./esm/index.d.ts",
        "default": "./esm/index.js"
      }
    }
  },
  "types": "./esm/index.d.ts",
  "files": [
    "esm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://MasatoMakino@github.com/MasatoMakino/threejs-spherical-controls.git"
  },
  "author": "MasatoMakino <unagiinu.g@gmail.com>",
  "license": "MIT",
  "keywords": [
    "threejs"
  ],
  "peerDependencies": {
    "@masatomakino/raf-ticker": "0.5.3 - 0.6.x",
    "@tweenjs/tween.js": "^25.0.0",
    "eventemitter3": "^5.0.1",
    "three": ">=0.126.0 <1.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@masatomakino/demo-showcase": "^0.1.2",
    "@tweenjs/tween.js": "^25.0.0",
    "@types/three": "^0.180.0",
    "@vitest/coverage-istanbul": "5.0.5",
    "eventemitter3": "^5.0.1",
    "jsdom": "^28.0.0",
    "lil-gui": "^0.21.0",
    "three": "^0.183.2",
    "typescript": "^5.9.2",
    "vitest": "5.0.5"
  },
  "scripts": {
    "test": "vitest --run",
    "test:watch": "vitest",
    "coverage": "vitest --coverage --run",
    "pre-commit": "biome format --write --no-errors-on-unmatched --files-ignore-unknown=true",
    "pre-push": "biome ci . && pnpm test",
    "start:dev": "pnpm run watch:tsc & demo-showcase dev --srcDir ./demoSrc --body '<canvas id=\"webgl-canvas\" width=\"1920\" height=\"1080\"></canvas>' --port 3000 --host 0.0.0.0",
    "build": "pnpm run demo",
    "demo": "pnpm run buildTS && demo-showcase build --srcDir ./demoSrc --body '<canvas id=\"webgl-canvas\" width=\"1920\" height=\"1080\"></canvas>'",
    "buildTS": "tsc",
    "watch:tsc": "tsc -W --incremental"
  },
  "description": "Spherical camera controller for Three.js",
  "bugs": {
    "url": "https://github.com/MasatoMakino/threejs-spherical-controls/issues"
  },
  "homepage": "https://github.com/MasatoMakino/threejs-spherical-controls#readme",
  "directories": {
    "doc": "docs",
    "lib": "esm"
  }
}
